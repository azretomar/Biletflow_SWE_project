# Copy to backend/.env and fill in. Never commit .env.
# For `npm run dev` + `go run .` on the host use localhost;
# docker-compose overrides DATABASE_URL to point at the `db` service.
DATABASE_URL=postgres://biletflow:biletflow@localhost:5432/biletflow?sslmode=disable
# At least 32 characters, e.g. generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
PORT=8080
